# Segredos e ajustes desta fita (copie para .env; o .env nunca vai para o Git).
# Valores aqui sobrescrevem o .env do tocador.

# Bot do Telegram desta fita. Melhor criar pelo K7: npm run perfil -- bot agrominds --gerente (ou --token)
# TELEGRAM_BOT_TOKEN=
# Donos do bot (sempre entram e aprovam os pedidos); se vazio, valem os do .env do tocador
# TELEGRAM_ALLOWED_USER_IDS=

# Painel administrativo (Angular), no processo do bot. Só neste computador por padrão;
# 0.0.0.0 abre na rede (para apresentar), sempre com login.
# ADMIN_PORTA=8790
# ADMIN_HOST=127.0.0.1

# Nome da cidade a partir da localização (OpenStreetMap/Nominatim). off = mostra só a coordenada.
# AGRO_GEOCODIFICAR=on

# Endereço da API de previsão (padrão: Open-Meteo público, gratuito e sem chave, uso não comercial)
# OPENMETEO_URL=https://api.open-meteo.com/v1/forecast

# Boletim, /clima, previsão, plantas e calendário como imagem (print dos layouts/ com o Chrome ou o Edge da máquina;
# off = só texto)
# AGRO_IMAGEM=on

# Época de plantio: baixa o zoneamento agrícola (ZARC) do portal de dados abertos do MAPA uma vez por safra
# (~750 MB lidos aos poucos; guarda ~25 MB). off = não baixa (o calendário fica indisponível)
# AGRO_ZARC=on
